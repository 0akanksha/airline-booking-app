# Database (Neon serverless Postgres)
DATABASE_URL=

# Auth
JWT_SECRET=
PORT=4000
NODE_ENV=development

# Seeds an initial admin user on first run (no public signup — passenger
# booking is guest-only, admin accounts are seeded this way)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Live flight status lookup (aviationstack.com free tier)
AVIATIONSTACK_API_KEY=

# Flight search + booking (duffel.com test token) — the only flight/booking
# data source; payment is Duffel's simulated test-mode balance, not Stripe.
DUFFEL_API_KEY=
